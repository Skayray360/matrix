# Creado por Aldo Garcia.
# ---------------------------------------------------------------------------
# Endurecimiento de la instalacion de dependencias de Matrix RH.
#
# Este archivo lo leen TANTO npm COMO pnpm. El gestor oficial del proyecto es
# pnpm (campo "packageManager" en package.json), pero la regla de seguridad no
# depende del gestor.
#
# ignore-scripts=true es el control central: los gusanos del ecosistema npm se
# propagan ejecutando `preinstall`/`install`/`postinstall` en el equipo que
# instala. Con esta linea, aunque un paquete comprometido entre al arbol, su
# codigo NO se ejecuta durante la instalacion. pnpm honra esta bandera igual que
# npm. Ademas, cada instalador la repite en la linea de comandos
# (`--ignore-scripts`) para que el control no dependa de este archivo editable.
#
# Es viable en este proyecto porque la unica dependencia que usaba un script de
# instalacion (esbuild) resuelve su binario por optionalDependencies
# (@esbuild/<plataforma>), no por descarga en postinstall.
#
# Playwright SI necesita descargar navegadores; se hace de forma explicita y
# consciente con `pnpm run e2e:install`, nunca de forma implicita al instalar.
# ---------------------------------------------------------------------------

ignore-scripts=true

# Instalacion reproducible: se respeta el lockfile y no se resuelven rangos.
save-exact=true

# Solo el registro oficial. Evita que un .npmrc heredado apunte a un espejo.
registry=https://registry.npmjs.org/

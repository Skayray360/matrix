{
  "name": "matrix-rh-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "description": "Interfaz de Matrix RH (React + TypeScript + Vite)",
  "author": "Aldo Garcia",
  "packageManager": "pnpm@9.15.9+sha512.aARhQYk8ZvrQHAeSMRKOmvuJ74fiaR1p5NQO7iKJiClf1GghgbrlW1hBjDolO95lpQXsfF-UA-zlzDzTfc8lMQ",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run typecheck && npm test && npm run build",
    "ci": "npm run check",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "audit:prod": "npm audit --omit=dev --audit-level low",
    "audit:all": "npm audit"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "6.6.3",
    "@testing-library/react": "16.1.0",
    "@testing-library/user-event": "14.5.2",
    "@types/node": "22.20.1",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "@vitejs/plugin-react": "6.0.5",
    "jsdom": "25.0.1",
    "typescript": "5.7.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
